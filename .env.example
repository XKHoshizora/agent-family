# Local default. For a public deployment set the exact HTTPS origin and HOST=0.0.0.0.
APP_URL=http://localhost:4317
HOST=127.0.0.1
PORT=4317
DATA_DIR=./data
# Existing CanalAPI-Key.txt is read automatically on this computer.
# CANAL_API_KEY=
CANAL_BASE_URL=https://api.canalapi.com/v1
DAILY_MODEL_CALLS=300
DAILY_LINE_MODEL_CALLS=40
MAX_OUTPUT_TOKENS=1600
# MiniMax includes thinking in its output budget; reserve room for the final answer.
MINIMAX_MAX_OUTPUT_TOKENS=8192
CLAUDE_MAX_OUTPUT_TOKENS=8192
# Optional: persist your own secrets; otherwise generated once in DATA_DIR/.secrets.json.
# AUTH_SECRET=at-least-32-random-characters
# ENCRYPTION_KEY=64-hex-characters
# SETUP_TOKEN=strong-random-token-for-remote-initial-setup
# PROVIDER_ALLOWED_HOSTS=your-private-llm.example.com
# TRUST_PROXY=actual-reverse-proxy-IP-or-CIDR
