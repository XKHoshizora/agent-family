{
  "name": "agent-family",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Private multi-agent conversations on Web and LINE",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build && tsup",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "setup": "tsx scripts/setup.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "format": "prettier --write src server shared scripts tests *.ts",
    "check": "tsc --noEmit",
    "setup:prod": "node dist-server/setup.js",
    "backup:prod": "node dist-server/backup.js",
    "restore:prod": "node dist-server/restore.js",
    "reset-password:prod": "node dist-server/reset-password.js",
    "notices": "node scripts/generate-notices.mjs",
    "prebuild": "node scripts/generate-notices.mjs",
    "build:element": "esbuild scripts/element-login.ts --bundle --format=esm --target=es2022 --outfile=deploy/element/af-login.js --minify"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.118",
    "@ai-sdk/openai": "^4.0.115",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@better-auth/oauth-provider": "1.7.25",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@line/bot-sdk": "^11.4.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.107.1",
    "@vector-im/matrix-bot-sdk": "0.11.0-element.0",
    "ai": "^7.0.170",
    "better-auth": "1.7.25",
    "better-sqlite3": "^13.1.1",
    "diff": "^9.0.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "railway": "^3.16.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "esbuild@0.28.2": true,
    "@matrix-org/matrix-sdk-crypto-nodejs@0.7.0": true
  }
}
