{
  "name": "agent-family-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/cli.ts migrate",
    "migrate:prod": "node --enable-source-maps dist/cli.js migrate",
    "invite:create": "tsx src/cli.ts invite:create",
    "invite:create:prod": "node --enable-source-maps dist/cli.js invite:create",
    "inbox:list": "tsx src/cli.ts inbox:list",
    "inbox:list:prod": "node --enable-source-maps dist/cli.js inbox:list",
    "attachments:sweep": "tsx src/cli.ts attachments:sweep",
    "attachments:sweep:prod": "node --enable-source-maps dist/cli.js attachments:sweep"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-storage": "^3.1169.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/websocket": "^11.3.7",
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "file-type": "^22.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  }
}
